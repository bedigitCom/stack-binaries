# The PHP extensions in every build, read by build-php.sh and php-check.sh. A new PHP version built
# with build-php.sh gets all of them with no other change. To add one, put it in PHP_SEPARATE, check
# that static-php-cli supports it (config/ext.json at STATIC_PHP_CLI_COMMIT), and list it in the
# app's docs/php-extensions.html. For Windows, the app adds it from PECL: see that page.

# Built into PHP itself, so always on: other extensions, or Composer, need them.
PHP_BUILT_IN="ctype,dom,filter,iconv,mysqlnd,openssl,pdo,phar,posix,session,simplexml,tokenizer,xml,xmlreader,xmlwriter,zlib"

# Separate files, each one turned on and off from the app's Extensions tab.
PHP_SEPARATE="bcmath,bz2,calendar,curl,exif,fileinfo,ftp,gd,gmp,imagick,intl,mbstring,mysqli,pcntl,pdo_mysql,pdo_pgsql,pdo_sqlite,pgsql,redis,soap,sockets,sodium,sqlite3,ssh2,xdebug,zip"

# Separate files before PHP 8.5 only. From 8.5, OPcache is always part of PHP.
PHP_SEPARATE_BEFORE_8_5="opcache"

# The extensions a version should have as separate files. Takes the version, such as 8.4.27.
php_separate_for() {
  local minor="${1%.*}"
  if [[ "$(printf '%s\n' "$minor" 8.5 | sort -V | head -1)" != 8.5 ]]; then
    echo "$PHP_SEPARATE,$PHP_SEPARATE_BEFORE_8_5"
  else
    echo "$PHP_SEPARATE"
  fi
}
